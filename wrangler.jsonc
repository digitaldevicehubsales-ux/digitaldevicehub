{
  "name": "digitaldevicehub",
  "main": "worker-entry.js",
  "compatibility_date": "2026-09-18",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": ["/", "/marketplace", "/device", "/device.html", "/device/*", "/sitemap.xml", "/auth/session", "/auth/logout", "/api/supabase", "/social-card.png", "/dashboard", "/admin", "/director", "/phones/iphone", "/guides/buying-used-iphone", "/regions", "/seller-onboarding"]
  }
}
